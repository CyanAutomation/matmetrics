{
  "name": "matmetrics-auth-worker",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "wrangler dev --persist-to ../matmetrics-data/.wrangler/state",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface Env",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.18",
    "better-auth": "1.7.18",
    "jose": "6.2.15",
    "resend": "^6.37.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261030.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.143.1"
  }
}
