{
  "name": "matmetrics-auth-worker",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "wrangler dev --persist-to ../matmetrics-data/.wrangler/state",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface Env",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.27",
    "better-auth": "1.7.27",
    "jose": "6.2.18",
    "resend": "^6.39.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@cloudflare/workers-types": "^5.20261120.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1",
    "wrangler": "^4.166.0"
  }
}
