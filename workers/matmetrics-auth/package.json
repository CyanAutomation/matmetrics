{
  "name": "matmetrics-auth-worker",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "wrangler dev --persist-to ../matmetrics-data/.wrangler/state",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types --env-interface Env",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.14",
    "better-auth": "1.7.14",
    "jose": "6.2.14",
    "resend": "^6.36.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.11",
    "@cloudflare/workers-types": "^5.20261030.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.143.1"
  }
}
