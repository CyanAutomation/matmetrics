{
  "name": "matmetrics-data-worker",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply matmetrics-data --local",
    "migrate:remote": "wrangler d1 migrations apply matmetrics-data --remote",
    "migrate:remote:list": "wrangler d1 migrations list matmetrics-data --remote",
    "auth:migration:preflight": "node scripts/auth-migration-check.ts preflight",
    "auth:migration:verify": "node scripts/auth-migration-check.ts verify",
    "auth:retirement:preflight": "node scripts/auth-migration-check.ts retirement-preflight",
    "auth:retirement:verify": "node scripts/auth-migration-check.ts retirement-verify",
    "test:auth:migration-check": "node --test scripts/auth-migration-check.test.ts scripts/auth-retirement-migration.test.ts",
    "test": "node --experimental-test-module-mocks --import tsx --test src/index.test.ts src/index.runtime.test.ts",
    "typecheck": "npm run typecheck:worker && npm run typecheck:scripts",
    "typecheck:worker": "tsc --project tsconfig.worker.json --noEmit --incremental false",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json --noEmit --incremental false"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.11",
    "wrangler": "^4.143.1",
    "typescript": "^5.0.0"
  }
}
