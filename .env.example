# GitHub API token
# Fine-grained token with repository contents write access.
GITHUB_TOKEN=

# Cloudflare AI Gateway API
# Required for AI-powered technique suggestions and practice notes transformation
# Get your token with: wrangler auth token
CLOUDFLARE_API_TOKEN=

# OpenRouter key used by server-side JEV check-ins, verification, and fidelity checks.
# In Vercel, add this as an encrypted OPENROUTER_API_KEY environment variable.
# Never use a NEXT_PUBLIC_ prefix or commit a real key.
OPENROUTER_API_KEY=

# Cloudflare D1 data Worker. Keep both values server-only; do not prefix them
# with NEXT_PUBLIC_. The Worker secret must exactly match the Vercel value.
CLOUDFLARE_DATA_WORKER_URL=
MATMETRICS_INTERNAL_API_SECRET=

# Cloudflare Queues background-job executor (server-only)
# Use the public Vercel origin for the URL and generate a distinct long secret.
MATMETRICS_BACKGROUND_EXECUTOR_URL=
MATMETRICS_BACKGROUND_EXECUTOR_SECRET=

# Firebase client SDK
# Firebase console → Project Settings → Your web app
NEXT_PUBLIC_FIREBASE_API_KEY=
# Firebase console → Project Settings → Your web app
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Firebase console → Project Settings → Your web app
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Firebase console → Project Settings → Your web app
NEXT_PUBLIC_FIREBASE_APP_ID=
# Firebase console → Project Settings → Your web app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Firebase console → Project Settings → Your web app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Firebase admin SDK
# Firebase console → Project Settings → Service accounts → Generate new private key
# Option 1: Store the full JSON service account key as a single-line JSON string.
#   FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...",...}'
# Option 2: Point to a JSON file containing the service account key.
#   FIREBASE_SERVICE_ACCOUNT_PATH=./path/to/serviceAccountKey.json
# The JSON must include project_id, client_email, and private_key fields.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Authentication test mode
# Required: also set NODE_ENV=test in test environments.
# When enabled, both Next.js route handlers and Go HTTP API handlers accept
# `Authorization: Bearer test-token` instead of real Firebase tokens.
MATMETRICS_AUTH_TEST_MODE=

# Sentry
# Set this in Vercel for every deployment environment. It is explicitly made
# available to the browser bundle because browser-side Sentry needs the DSN.
# Use SENTRY_AUTH_TOKEN only in CI/Vercel to upload source maps and create releases.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
