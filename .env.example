# GitHub API token
# Fine-grained token with repository contents write access.
GITHUB_TOKEN=

# Cloudflare AI Gateway API
# Required for AI-powered technique suggestions and practice notes transformation
# Get your token with: wrangler auth token
CLOUDFLARE_API_TOKEN=

# OpenRouter key used by server-side JEV check-ins, verification, and fidelity checks.
# In Vercel, add this as an encrypted OPENROUTER_API_KEY environment variable.
# Never use a NEXT_PUBLIC_ prefix or commit a real key.
OPENROUTER_API_KEY=

# Optional server logs with JEV operation, resolved model, latency, and outcome metadata.
# Logs never include session text or JEV answer values. Leave unset to disable.
MATMETRICS_JEV_OBSERVABILITY=

# Cloudflare D1 data Worker. Keep both values server-only; do not prefix them
# with NEXT_PUBLIC_. The Worker secret must exactly match the Vercel value.
CLOUDFLARE_DATA_WORKER_URL=
MATMETRICS_INTERNAL_API_SECRET=

# Cloudflare Queues background-job executor (server-only)
# Use the public Vercel origin for the URL and generate a distinct long secret.
MATMETRICS_BACKGROUND_EXECUTOR_URL=
MATMETRICS_BACKGROUND_EXECUTOR_SECRET=

# Better Auth runs in a Cloudflare Worker bound directly to the existing D1
# database. This URL is used only by Next.js rewrites and stays server-side.
CLOUDFLARE_AUTH_WORKER_URL=
# The public flag enables Better Auth controls in the browser after the Worker
# and same-origin /api/auth rewrite are deployed.
NEXT_PUBLIC_BETTER_AUTH_ENABLED=false
NEXT_PUBLIC_EMAIL_PASSWORD_SIGNUP_ENABLED=false
# Browser visibility flags; the auth Worker enforces the same policy server-side.
NEXT_PUBLIC_PASSKEY_ENROLMENT_ENABLED=true
# Same-origin JWKS URL used by Next.js and Go API verification. Do not use a secret.
MATMETRICS_AUTH_JWKS_URL=
# Issuer and audience must exactly match the Better Auth JWT plugin configuration.
# The Go API requires all three values when verifying Better Auth service JWTs.
MATMETRICS_AUTH_ISSUER=
MATMETRICS_AUTH_AUDIENCE=matmetrics-api

# Firebase Admin SDK, retained for Firestore-backed preferences and plugin state.
# Firebase console → Project Settings → Service accounts → Generate new private key
# Store the full JSON service account key as a single-line JSON string.
#   FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"...",...}'
# The JSON must include project_id, client_email, and private_key fields.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Authentication test mode
# Required: also set NODE_ENV=test in test environments.
# When enabled, both Next.js route handlers and Go HTTP API handlers accept
# `Authorization: Bearer test-token` instead of real Better Auth tokens.
MATMETRICS_AUTH_TEST_MODE=

# Sentry
# Set this in Vercel for every deployment environment. It is explicitly made
# available to the browser bundle because browser-side Sentry needs the DSN.
# Use SENTRY_AUTH_TOKEN only in CI/Vercel to upload source maps and create releases.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
