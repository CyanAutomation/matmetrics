{
  "minimumVersion": "3.22.0",
  "framework": [
    {
      "name": "matmetrics-tests",
      "detection": {
        "type": "fileExists",
        "pattern": "package.json"
      },
      "entryPoints": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.test.js",
        "**/*.test.mjs",
        "**/*.spec.ts",
        "**/*.spec.tsx"
      ],
      "entryPointRole": "test"
    }
  ],
  "ignorePatterns": ["scripts/__fixtures__/**"],
  "ignoreDependencies": ["react-dom", "tailwindcss-animate"],
  "dynamicallyLoaded": ["tailwind.config.ts", "postcss.config.mjs"],
  "ignoreExports": [
    {
      "file": "plugins/**/src/index.ts",
      "exports": ["initPlugin"]
    },
    {
      "file": "src/app/api/**/api-handler.ts",
      "exports": ["GET", "POST", "PUT", "PATCH", "DELETE"]
    },
    {
      "file": "plugins/video-library/src/components/video-library-panel.tsx",
      "exports": [
        "VIDEO_LIBRARY_REMOVE_DOMAIN_CONFIRM_LABEL",
        "VIDEO_LIBRARY_REMOVE_DOMAIN_CANCEL_LABEL",
        "buildVideoDomainRemovalConfirmationDescription"
      ]
    },
    {
      "file": "plugins/video-library/src/components/video-library.tsx",
      "exports": [
        "VIDEO_LIBRARY_REMOVE_DOMAIN_CONFIRM_LABEL",
        "VIDEO_LIBRARY_REMOVE_DOMAIN_CANCEL_LABEL",
        "buildVideoDomainRemovalConfirmationDescription"
      ]
    },
    {
      "file": "src/lib/plugins/dashboard-tab-adapters.tsx",
      "exports": ["PluginComponentRegistration"]
    },
    {
      "file": "src/lib/plugins/scoring/index.ts",
      "exports": [
        "CategoryScoringResult",
        "TierEvaluationResult",
        "TestCoverageInput",
        "TierDeterminationInput"
      ]
    },
    {
      "file": "src/lib/sync-lease.ts",
      "exports": ["ActiveSyncLease", "LeaseTakeoverReason"]
    }
  ],
  "health": {
    "maxCognitive": 15
  }
}
